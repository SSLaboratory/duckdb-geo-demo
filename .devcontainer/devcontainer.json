  // Container user - ensures we run as vscode user
  "containerUser": "vscode",

  // Update remote user UID to match
  "updateRemoteUserUID": true,

  // Post-start command: Fix permissions on mounted volumes
  "postStartCommand": "sudo chown -R vscode:vscode /workspace /home/vscode/.cache 2>/dev/null || true",
